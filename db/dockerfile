# Stage 1: Builder
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy the go.mod and go.sum files first to cache dependencies
# (Assuming these are in your root directory, even though they aren't in the tree output)
COPY go.mod go.sum* ./
RUN go mod download

# Copy the rest of your source code (engine, pb, cmd, etc.)
COPY . .

# Compile a statically linked binary for your Apple Silicon architecture
# Notice the target path: ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o vector-worker ./cmd/server

# Stage 2: Minimal Runtime
FROM alpine:latest
WORKDIR /root/

# Copy the compiled binary from the builder stage
COPY --from=builder /app/vector-worker .

# Expose the gRPC port
EXPOSE 50051

# Run the binary
CMD ["./vector-worker"]