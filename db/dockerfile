# Stage 1: Builder
# CHANGE: Use latest alpine builder to satisfy modern gRPC dependencies
FROM golang:alpine AS builder

WORKDIR /app

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN go mod tidy

RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o vector-worker ./cmd/server

# Stage 2: Minimal Runtime
FROM alpine:latest
WORKDIR /root/

COPY --from=builder /app/vector-worker .

EXPOSE 50051

CMD ["./vector-worker"]