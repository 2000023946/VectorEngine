FROM python:3.11-slim

WORKDIR /app

# 1. Copy only requirements first to cache the pip install step
COPY requirements.txt .

# 2. Install dependencies (no-cache-dir keeps the image size small)
RUN pip install --no-cache-dir -r requirements.txt

# 3. Copy the rest of the application code
# (The .dockerignore will prevent venv and __pycache__ from copying over)
COPY . .

# 4. Expose the port Uvicorn will run on
EXPOSE 8000

# 5. Start the FastAPI server
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "8"]